{
    "compilerOptions": {
        "target": "ES2023",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,

        "baseUrl": ".",
        "paths": {
            "@todoapp/shared/*": ["../shared/src/*"]
        }
    }
}
